# ── Zoho Catalyst QuickML ─────────────────────────────────────────────────────
QUICKML_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/<PROJECT_ID>/endpoints/predict
QUICKML_API_KEY=<X-QUICKML-ENDPOINT-KEY from the Endpoints page>

# OAuth client-credentials (Catalyst console → project settings → API Keys)
CLIENT_ID=
CLIENT_SECRET=

# Org + environment (CATALYST-ORG = your org ZUID, from catalyst project:list)
CATALYST_ORG=
CATALYST_ENVIRONMENT=Development

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
